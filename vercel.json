{
  "crons": [
    {
      "path": "/api/cron/users-excel",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "app/api/upload/video/route.ts": {
      "maxDuration": 30
    },
    "app/api/telegram/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/telegram/status/route.ts": {
      "maxDuration": 30
    },
    "app/api/tests/submit/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/users-excel/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/users/export/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/upload/video",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
